@page "/login"
@using ProyectoFarmaVita.Services.AuthServices
@using System.ComponentModel.DataAnnotations
@inject IAuthService AuthService
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject IJSRuntime JSRuntime

<PageTitle>FarmaVita - Iniciar Sesión</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
    <MudPaper Elevation="8" Class="pa-8" Style="border-radius: 16px; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
        <MudGrid>
            <!-- Logo y Título -->
            <MudItem xs="12" Class="text-center mb-6">
                <MudImage Src="images/Logo FarmaVita.png" Width="120" Height="120" Alt="FarmaVita Logo" Class="mb-4" />
                <MudText Typo="Typo.h3" Color="Color.Surface" Class="mb-2" Style="font-weight: 700;">
                    FarmaVita
                </MudText>
                <MudText Typo="Typo.subtitle1" Color="Color.Surface" Style="opacity: 0.9;">
                    Sistema de Gestión Farmacéutica
                </MudText>
            </MudItem>

            <!-- Formulario -->
            <MudItem xs="12">
                <MudPaper Elevation="0" Class="pa-6" Style="border-radius: 12px; background: rgba(255,255,255,0.95);">
                    <EditForm Model="@loginModel" OnValidSubmit="@HandleLogin">
                        <DataAnnotationsValidator />

                        <MudText Typo="Typo.h5" Class="mb-4 text-center" Color="Color.Primary">
                            Iniciar Sesión
                        </MudText>

                        <MudGrid Spacing="3">
                            <MudItem xs="12">
                                <MudTextField @bind-Value="loginModel.Email"
                                              Label="Correo Electrónico"
                                              For="@(() => loginModel.Email)"
                                              Variant="Variant.Outlined"
                                              InputType="InputType.Email"
                                              Adornment="Adornment.Start"
                                              AdornmentIcon="@Icons.Material.Filled.Email"
                                              AdornmentColor="Color.Primary"
                                              Required="true"
                                              Immediate="true"
                                              Class="login-field" />
                            </MudItem>

                            <MudItem xs="12">
                                <MudTextField @bind-Value="loginModel.Password"
                                              Label="Contraseña"
                                              For="@(() => loginModel.Password)"
                                              Variant="Variant.Outlined"
                                              InputType="@passwordInputType"
                                              Adornment="Adornment.End"
                                              AdornmentIcon="@passwordIcon"
                                              OnAdornmentClick="@TogglePasswordVisibility"
                                              AdornmentAriaLabel="Mostrar contraseña"
                                              Required="true"
                                              Immediate="true"
                                              Class="login-field" />
                            </MudItem>

                            <MudItem xs="12">
                                <MudCheckBox @bind-Value="loginModel.RememberMe"
                                             Color="Color.Primary"
                                             Label="Recordar mi sesión" />
                            </MudItem>

                            <MudItem xs="12">
                                <ValidationSummary class="validation-errors" />
                            </MudItem>

                            <MudItem xs="12">
                                <MudButton ButtonType="ButtonType.Submit"
                                           Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           Disabled="@isLoading"
                                           FullWidth="true"
                                           Size="Size.Large"
                                           Class="login-button">
                                    @if (isLoading)
                                    {
                                        <MudProgressCircular Class="mr-3" Size="Size.Small" Indeterminate="true" />
                                        <MudText>Iniciando sesión...</MudText>
                                    }
                                    else
                                    {
                                        <MudIcon Icon="@Icons.Material.Filled.Login" Class="mr-3" />
                                        <MudText>Iniciar Sesión</MudText>
                                    }
                                </MudButton>
                            </MudItem>
                        </MudGrid>
                    </EditForm>
                </MudPaper>
            </MudItem>

            <!-- Footer -->
            <MudItem xs="12" Class="text-center mt-4">
                <MudText Typo="Typo.caption" Color="Color.Surface" Style="opacity: 0.8;">
                    © 2024 FarmaVita. Todos los derechos reservados.
                </MudText>
            </MudItem>
        </MudGrid>
    </MudPaper>
</MudContainer>

<style>
    .login-field .mud-input-control {
        background-color: rgba(255, 255, 255, 0.9);
        border-radius: 8px;
    }

    .login-button {
        background: linear-gradient(45deg, #2196F3 30%, #21CBF3 90%);
        border-radius: 8px;
        height: 48px;
        font-weight: 600;
        text-transform: none;
        box-shadow: 0 3px 5px 2px rgba(33, 203, 243, .3);
        transition: all 0.3s ease;
    }

    .login-button:hover {
        box-shadow: 0 6px 10px 4px rgba(33, 203, 243, .3);
        transform: translateY(-2px);
    }

    .validation-errors {
        background-color: #ffebee;
        border: 1px solid #f44336;
        border-radius: 4px;
        padding: 12px;
        margin: 8px 0;
    }

    .validation-errors ul {
        margin: 0;
        padding-left: 20px;
        color: #d32f2f;
    }

    .validation-errors li {
        margin: 4px 0;
    }

    body {
        background: linear-gradient(135deg, #74b9ff 0%, #0984e3 100%);
        min-height: 100vh;
    }
</style>

@code {
    private LoginModel loginModel = new();
    private bool isLoading = false;
    private bool showPassword = false;
    private InputType passwordInputType = InputType.Password;
    private string passwordIcon = Icons.Material.Filled.VisibilityOff;

    protected override async Task OnInitializedAsync()
    {
        // Si ya está autenticado, redirigir al dashboard
        if (AuthService.IsAuthenticated)
        {
            NavigationManager.NavigateTo("/");
        }
    }

    private async Task HandleLogin()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            var result = await AuthService.LoginAsync(loginModel.Email, loginModel.Password);

            if (result.Success)
            {
                Snackbar.Add($"¡Bienvenido, {result.User?.Nombre}!", Severity.Success);

                // Redirigir según el rol
                var redirectUrl = await GetRedirectUrlByRole();
                NavigationManager.NavigateTo(redirectUrl);
            }
            else
            {
                Snackbar.Add(result.Message ?? "Error al iniciar sesión", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error inesperado: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task<string> GetRedirectUrlByRole()
    {
        var roles = await AuthService.GetUserRolesAsync();

        if (roles.Contains("Administrador"))
        {
            return "/dashboard/admin";
        }
        else if (roles.Contains("Gerente"))
        {
            return "/dashboard/gerente";
        }
        else if (roles.Contains("Farmaceuta"))
        {
            return "/dashboard/farmaceuta";
        }
        else if (roles.Contains("Vendedor"))
        {
            return "/dashboard/vendedor";
        }

        return "/"; // Página por defecto
    }

    private void TogglePasswordVisibility()
    {
        if (showPassword)
        {
            showPassword = false;
            passwordInputType = InputType.Password;
            passwordIcon = Icons.Material.Filled.VisibilityOff;
        }
        else
        {
            showPassword = true;
            passwordInputType = InputType.Text;
            passwordIcon = Icons.Material.Filled.Visibility;
        }
    }

    public class LoginModel
    {
        [Required(ErrorMessage = "El email es requerido")]
        [EmailAddress(ErrorMessage = "Formato de email inválido")]
        public string Email { get; set; } = "";

        [Required(ErrorMessage = "La contraseña es requerida")]
        [MinLength(3, ErrorMessage = "La contraseña debe tener al menos 3 caracteres")]
        public string Password { get; set; } = "";

        public bool RememberMe { get; set; } = false;
    }
}