@page "/login"
@layout LoginLayout
@using ProyectoFarmaVita.Components.Layout
@using ProyectoFarmaVita.Services.AuthServices
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization
@using MudBlazor
@inject IAuthService AuthService
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject ILogger<Login> Logger
@attribute [AllowAnonymous]

<PageTitle>FarmaVita - Iniciar Sesión</PageTitle>

<MudPaper Elevation="0" Class="mud-paper">
    <div class="login-card-content">

        <!-- Header -->
        <div class="login-header">
            <MudIcon Icon="@Icons.Material.Filled.LocalPharmacy" Class="login-icon" />
            <MudText Typo="Typo.h3" Class="login-title">FarmaVita</MudText>
            <MudText Typo="Typo.subtitle1" Class="login-subtitle">
                Sistema de Gestión Farmacéutica
            </MudText>
        </div>

        <!-- Formulario de Login -->
        <div class="login-form">
            <MudText Typo="Typo.h5" Class="login-form-title">
                Iniciar Sesión
            </MudText>

            <!-- Campo Email -->
            <MudTextField @bind-Value="email"
                          Label="Correo Electrónico"
                          Variant="Variant.Outlined"
                          InputType="InputType.Email"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Email"
                          AdornmentColor="Color.Primary"
                          Required="true"
                          FullWidth="true"
                          Class="mb-3"
                          Error="@(!string.IsNullOrEmpty(emailError))"
                          ErrorText="@emailError"
                          @onkeypress="@(async (e) => await OnKeyPress(e))" />

            <!-- Campo Contraseña -->
            <MudTextField @bind-Value="password"
                          Label="Contraseña"
                          Variant="Variant.Outlined"
                          InputType="@passwordInputType"
                          Adornment="Adornment.End"
                          AdornmentIcon="@passwordIcon"
                          OnAdornmentClick="@TogglePasswordVisibility"
                          AdornmentAriaLabel="Mostrar contraseña"
                          Required="true"
                          FullWidth="true"
                          Class="mb-3"
                          Error="@(!string.IsNullOrEmpty(passwordError))"
                          ErrorText="@passwordError"
                          @onkeypress="@(async (e) => await OnKeyPress(e))" />

            <!-- Checkbox Recordar -->
            <MudCheckBox @bind-Value="rememberMe"
                         Color="Color.Primary"
                         Label="Recordar mi sesión"
                         Class="login-checkbox" />

            <!-- Errores de Login -->
            @if (hasErrors)
            {
                <MudAlert Severity="Severity.Error" Class="my-3">
                    @errorMessage
                </MudAlert>
            }

            <!-- ✅ INFORMACIÓN DE DEBUG -->
            @if (showDebugInfo)
            {
                <MudPaper Class="pa-2 my-2" Elevation="1">
                    <MudText Typo="Typo.caption">
                        <strong>Debug Info:</strong><br />
                        AuthService: @(AuthService != null ? "✅ OK" : "❌ NULL")<br />
                        IsAuthenticated: @(AuthService?.IsAuthenticated ?? false)<br />
                        Last Error: @lastDebugError
                    </MudText>
                </MudPaper>
            }

            <!-- Botón Submit -->
            <MudButton OnClick="@HandleLogin"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       Disabled="@isLoading"
                       FullWidth="true"
                       Size="Size.Large"
                       Class="login-button mt-3"
                       ButtonType="ButtonType.Button">
                @if (isLoading)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                    <span style="margin-left: 8px;">Iniciando sesión...</span>
                }
                else
                {
                    <MudIcon Icon="@Icons.Material.Filled.Login" Style="margin-right: 8px;" />
                    <span>Iniciar Sesión</span>
                }
            </MudButton>

            <!-- Botones de DEBUG -->
            <div class="mt-2">
                <MudButton OnClick="@TestConnection"
                           Variant="Variant.Text"
                           Color="Color.Info"
                           Size="Size.Small"
                           Class="mr-2">
                    🔧 Test Connection
                </MudButton>

                <MudButton OnClick="@ToggleDebugInfo"
                           Variant="Variant.Text"
                           Color="Color.Secondary"
                           Size="Size.Small">
                    @(showDebugInfo ? "Hide" : "Show") Debug
                </MudButton>
            </div>
        </div>

        <!-- Enlaces -->
        <MudDivider Class="my-4" />
        <div class="login-links">
            <MudLink Href="#" Color="Color.Primary" Underline="Underline.Hover">
                ¿Olvidaste tu contraseña?
            </MudLink>
        </div>

        <!-- Footer -->
        <div class="login-footer">
            <MudText Typo="Typo.caption" Color="Color.Secondary">
                © 2024 FarmaVita. Todos los derechos reservados.
            </MudText>
        </div>

    </div>
</MudPaper>

@code {
    // Variables del formulario
    private string email = string.Empty;
    private string password = string.Empty;
    private bool rememberMe = false;

    // Variables de estado
    private bool isLoading = false;
    private bool showPassword = false;
    private InputType passwordInputType = InputType.Password;
    private string passwordIcon = Icons.Material.Filled.VisibilityOff;
    private bool hasErrors = false;
    private string errorMessage = string.Empty;

    // Variables de validación
    private string emailError = string.Empty;
    private string passwordError = string.Empty;

    // ✅ DEBUG variables
    private bool showDebugInfo = false;
    private string lastDebugError = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Logger.LogInformation("🔧 LOGIN: Inicializando página de login...");

            // ✅ Verificación detallada de servicios
            if (AuthService == null)
            {
                var error = "AuthService es null!";
                Logger.LogError("❌ LOGIN: {Error}", error);
                lastDebugError = error;
                return;
            }

            Logger.LogInformation("✅ LOGIN: AuthService disponible");

            // Verificar si ya está autenticado
            try
            {
                if (AuthService.IsAuthenticated)
                {
                    Logger.LogInformation("✅ LOGIN: Usuario ya autenticado, redirigiendo...");
                    NavigationManager.NavigateTo("/", replace: true);
                    return;
                }
            }
            catch (Exception authEx)
            {
                Logger.LogWarning("⚠️ LOGIN: Error verificando autenticación: {Error}", authEx.Message);
                lastDebugError = $"Auth check error: {authEx.Message}";
            }

            Logger.LogInformation("✅ LOGIN: Página inicializada correctamente");
        }
        catch (Exception ex)
        {
            var error = $"Error en OnInitializedAsync: {ex.Message}";
            Logger.LogError(ex, "💥 LOGIN ERROR: {Error}", error);
            lastDebugError = error;
            hasErrors = true;
            errorMessage = "Error inicializando la página de login";
        }
    }

    // ✅ MÉTODO DE TEST DE CONEXIÓN
    private async Task TestConnection()
    {
        try
        {
            Logger.LogInformation("🔧 TEST CONNECTION: Iniciando...");
            lastDebugError = "Testing...";

            if (AuthService == null)
            {
                lastDebugError = "AuthService is NULL!";
                Snackbar.Add("❌ AuthService no disponible", Severity.Error);
                return;
            }

            // Test básico del servicio
            var isAuth = AuthService.IsAuthenticated;
            lastDebugError = $"IsAuthenticated: {isAuth}";

            Snackbar.Add("✅ AuthService conectado correctamente", Severity.Success);
            Logger.LogInformation("✅ TEST CONNECTION: OK");
        }
        catch (Exception ex)
        {
            lastDebugError = $"Connection test failed: {ex.Message}";
            Logger.LogError(ex, "❌ TEST CONNECTION failed: {Error}", ex.Message);
            Snackbar.Add($"❌ Error de conexión: {ex.Message}", Severity.Error);
        }
        finally
        {
            StateHasChanged();
        }
    }

    private void ToggleDebugInfo()
    {
        showDebugInfo = !showDebugInfo;
        StateHasChanged();
    }

    private bool ValidateForm()
    {
        emailError = string.Empty;
        passwordError = string.Empty;
        bool isValid = true;

        Logger.LogDebug("🔧 VALIDACIÓN - Email: '{Email}', Password length: {Length}",
            email, password?.Length ?? 0);

        // Validar email
        if (string.IsNullOrWhiteSpace(email))
        {
            emailError = "El email es requerido";
            isValid = false;
        }
        else if (!IsValidEmail(email))
        {
            emailError = "Formato de email inválido";
            isValid = false;
        }

        // Validar password
        if (string.IsNullOrWhiteSpace(password))
        {
            passwordError = "La contraseña es requerida";
            isValid = false;
        }
        else if (password.Length < 3)
        {
            passwordError = "La contraseña debe tener al menos 3 caracteres";
            isValid = false;
        }

        Logger.LogDebug("🔧 VALIDACIÓN resultado: {IsValid}", isValid);
        return isValid;
    }

    private bool IsValidEmail(string email)
    {
        try
        {
            var addr = new System.Net.Mail.MailAddress(email);
            return addr.Address == email;
        }
        catch
        {
            return false;
        }
    }

    private async Task HandleLogin()
    {
        Logger.LogInformation("🔧 HANDLE LOGIN: Método iniciado");

        if (isLoading)
        {
            Logger.LogWarning("⚠️ Ya está cargando, ignorando click");
            return;
        }

        isLoading = true;
        hasErrors = false;
        errorMessage = string.Empty;
        lastDebugError = "Login in progress...";

        // Forzar actualización de UI
        await InvokeAsync(StateHasChanged);

        try
        {
            Logger.LogInformation("🔧 LOGIN DEBUG - Email: '{Email}', Password length: {Length}",
                email, password?.Length ?? 0);

            // ✅ Verificación defensiva de AuthService
            if (AuthService == null)
            {
                throw new InvalidOperationException("AuthService no está disponible - servicio no inyectado correctamente");
            }

            // Validar formulario
            if (!ValidateForm())
            {
                Logger.LogWarning("❌ Validación de formulario falló");
                lastDebugError = "Form validation failed";
                await InvokeAsync(StateHasChanged);
                return;
            }

            Logger.LogInformation("✅ Validación OK, llamando a AuthService...");
            lastDebugError = "Calling AuthService.LoginAsync...";

            // ✅ LLAMADA PROTEGIDA al AuthService
            var result = await AuthService.LoginAsync(email.Trim(), password);

            Logger.LogInformation("🔧 Resultado del login - Success: {Success}", result?.Success ?? false);

            if (result?.Success == true)
            {
                Logger.LogInformation("✅ Login exitoso - Redirigiendo...");
                lastDebugError = "Login successful";
                Snackbar.Add($"¡Bienvenido, {result.User?.Nombre ?? "Usuario"}!", Severity.Success);

                await Task.Delay(500);
                NavigationManager.NavigateTo("/", replace: true);
            }
            else
            {
                var errorMsg = result?.Message ?? "Credenciales incorrectas";
                Logger.LogWarning("❌ Login fallido: {Error}", errorMsg);
                lastDebugError = $"Login failed: {errorMsg}";
                hasErrors = true;
                errorMessage = errorMsg;
                Snackbar.Add(errorMessage, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            var errorMsg = $"Error en login: {ex.Message}";
            Logger.LogError(ex, "💥 {Error}", errorMsg);
            lastDebugError = errorMsg;
            hasErrors = true;
            errorMessage = "Error del sistema. Verifique la consola para más detalles.";
            Snackbar.Add(errorMessage, Severity.Error);
        }
        finally
        {
            isLoading = false;
            await InvokeAsync(StateHasChanged);
            Logger.LogInformation("🔧 LOGIN: Proceso finalizado");
        }
    }

    private void TogglePasswordVisibility()
    {
        if (showPassword)
        {
            showPassword = false;
            passwordInputType = InputType.Password;
            passwordIcon = Icons.Material.Filled.VisibilityOff;
        }
        else
        {
            showPassword = true;
            passwordInputType = InputType.Text;
            passwordIcon = Icons.Material.Filled.Visibility;
        }
        StateHasChanged();
    }

    private async Task OnKeyPress(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !isLoading)
        {
            Logger.LogDebug("🔧 Enter presionado, ejecutando login");
            await HandleLogin();
        }
    }
}