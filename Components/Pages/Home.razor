@page "/"
@using ProyectoFarmaVita.Services.AuthServices
@using Microsoft.AspNetCore.Authorization
@inject IAuthService AuthService
@inject NavigationManager NavigationManager
@attribute [Authorize]

<PageTitle>FarmaVita - Dashboard</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4">
    
    @if (currentUser != null)
    {
        <!-- Dashboard basado en el rol del usuario -->
        @if (currentUser.IdRoolNavigation?.TipoRol == "Administrador")
        {
            <AdminDashboard />
        }
        else if (currentUser.IdRoolNavigation?.TipoRol == "Gerente")
        {
            <GerenteDashboard />
        }
        else if (currentUser.IdRoolNavigation?.TipoRol == "Farmaceuta")
        {
            <FarmaceutaDashboard />
        }
        else if (currentUser.IdRoolNavigation?.TipoRol == "Vendedor")
        {
            <VendedorDashboard />
        }
        else
        {
            <!-- Dashboard genérico -->
            <DefaultDashboard />
        }
    }
    else
    {
        <MudContainer Class="d-flex justify-center align-center" Style="height: 50vh;">
            <MudProgressCircular Indeterminate="true" Size="Size.Large" />
        </MudContainer>
    }
    
</MudContainer>

@code {
    private Models.Persona? currentUser;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Console.WriteLine("🔧 HOME: Inicializando dashboard...");
            
            // Verificar autenticación
            if (!AuthService.IsAuthenticated)
            {
                Console.WriteLine("❌ HOME: Usuario no autenticado");
                NavigationManager.NavigateTo("/login", forceLoad: true);
                return;
            }

            // Obtener usuario actual
            currentUser = await AuthService.GetCurrentUserAsync();
            
            if (currentUser == null)
            {
                Console.WriteLine("❌ HOME: No se pudo obtener usuario actual");
                NavigationManager.NavigateTo("/login", forceLoad: true);
                return;
            }

            Console.WriteLine($"✅ HOME: Usuario cargado - {currentUser.Nombre} ({currentUser.IdRoolNavigation?.TipoRol})");
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"💥 HOME ERROR: {ex.Message}");
            NavigationManager.NavigateTo("/login", forceLoad: true);
        }
    }
}

@* Componentes de Dashboard por Rol *@

<AdminDashboard>
    <MudGrid Spacing="3">
        <MudItem xs="12">
            <MudPaper Elevation="2" Class="pa-4">
                <MudText Typo="Typo.h4" Color="Color.Primary">
                    <MudIcon Icon="@Icons.Material.Filled.AdminPanelSettings" Class="mr-3" />
                    Panel de Administración
                </MudText>
                <MudText Typo="Typo.body1" Color="Color.Secondary">
                    Bienvenido, @currentUser?.Nombre @currentUser?.Apellido
                </MudText>
            </MudPaper>
        </MudItem>
        
        <!-- Tarjetas de acceso rápido -->
        <MudItem xs="12" md="6" lg="3">
            <MudCard Elevation="3" Class="pa-4 hover-card">
                <MudCardContent>
                    <div class="d-flex align-center">
                        <MudIcon Icon="@Icons.Material.Filled.People" Size="Size.Large" Color="Color.Primary" />
                        <div class="ml-4">
                            <MudText Typo="Typo.h6">Gestión Personal</MudText>
                            <MudButton Variant="Variant.Text" Color="Color.Primary" Href="/personas">Ver Personas</MudButton>
                        </div>
                    </div>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <MudItem xs="12" md="6" lg="3">
            <MudCard Elevation="3" Class="pa-4 hover-card">
                <MudCardContent>
                    <div class="d-flex align-center">
                        <MudIcon Icon="@Icons.Material.Filled.Inventory" Size="Size.Large" Color="Color.Secondary" />
                        <div class="ml-4">
                            <MudText Typo="Typo.h6">Inventarios</MudText>
                            <MudButton Variant="Variant.Text" Color="Color.Secondary" Href="/inventario">Ver Inventarios</MudButton>
                        </div>
                    </div>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <MudItem xs="12" md="6" lg="3">
            <MudCard Elevation="3" Class="pa-4 hover-card">
                <MudCardContent>
                    <div class="d-flex align-center">
                        <MudIcon Icon="@Icons.Material.Filled.Business" Size="Size.Large" Color="Color.Tertiary" />
                        <div class="ml-4">
                            <MudText Typo="Typo.h6">Sucursales</MudText>
                            <MudButton Variant="Variant.Text" Color="Color.Tertiary" Href="/sucursal">Ver Sucursales</MudButton>
                        </div>
                    </div>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <MudItem xs="12" md="6" lg="3">
            <MudCard Elevation="3" Class="pa-4 hover-card">
                <MudCardContent>
                    <div class="d-flex align-center">
                        <MudIcon Icon="@Icons.Material.Filled.Settings" Size="Size.Large" Color="Color.Warning" />
                        <div class="ml-4">
                            <MudText Typo="Typo.h6">Configuración</MudText>
                            <MudButton Variant="Variant.Text" Color="Color.Warning" Href="/roles">Ver Roles</MudButton>
                        </div>
                    </div>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>
</AdminDashboard>

