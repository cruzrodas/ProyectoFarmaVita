@using ProyectoFarmaVita.Services.AuthServices
@using Microsoft.AspNetCore.Authorization
@inject IAuthService AuthService
@inject NavigationManager NavigationManager

<MudNavMenu>
    <!-- Dashboard -->
    <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">
        Dashboard
    </MudNavLink>

    <MudDivider Class="my-2" />

    <!-- Gestión de Personal - Solo Admin y Gerente -->
    <AuthorizeView Roles="Administrador,Gerente">
        <MudNavGroup Text="Gestión Personal" Icon="@Icons.Material.Filled.People" Expanded="false">
            <MudNavLink Href="/personas" Icon="@Icons.Material.Filled.Person">
                Personas
            </MudNavLink>
            <AuthorizeView Roles="Administrador">
                <MudNavLink Href="/asignacion-turno" Icon="@Icons.Material.Filled.Schedule">
                    Turnos de Trabajo
                </MudNavLink>
            </AuthorizeView>
        </MudNavGroup>
    </AuthorizeView>

    <!-- Gestión de Productos - Admin, Gerente, Farmaceuta -->
    <AuthorizeView Roles="Administrador,Gerente,Farmaceuta">
        <MudNavGroup Text="Productos" Icon="@Icons.Material.Filled.Medication" Expanded="false">
            <MudNavLink Href="/producto" Icon="@Icons.Material.Filled.LocalPharmacy">
                Productos
            </MudNavLink>
            <MudNavLink Href="/categoria" Icon="@Icons.Material.Filled.Category">
                Categorías
            </MudNavLink>
            <MudNavLink Href="/proveedor" Icon="@Icons.Material.Filled.LocalShipping">
                Proveedores
            </MudNavLink>
        </MudNavGroup>
    </AuthorizeView>

    <!-- Inventarios - Admin, Gerente, Farmaceuta -->
    <AuthorizeView Roles="Administrador,Gerente,Farmaceuta">
        <MudNavLink Href="/inventario" Icon="@Icons.Material.Filled.Inventory">
            Inventarios
        </MudNavLink>
    </AuthorizeView>

    <!-- Ventas - Todos los roles -->
    <AuthorizeView Roles="Administrador,Gerente,Farmaceuta,Vendedor">
        <MudNavGroup Text="Ventas" Icon="@Icons.Material.Filled.PointOfSale" Expanded="false">
            <MudNavLink Href="/ventas" Icon="@Icons.Material.Filled.ShoppingCart">
                Punto de Venta
            </MudNavLink>
            <MudNavLink Href="/facturas" Icon="@Icons.Material.Filled.Receipt">
                Facturas
            </MudNavLink>
        </MudNavGroup>
    </AuthorizeView>

    <!-- Administración - Solo Admin y Gerente -->
    <AuthorizeView Roles="Administrador,Gerente">
        <MudDivider Class="my-2" />
        <MudNavGroup Text="Administración" Icon="@Icons.Material.Filled.Business" Expanded="false">
            <MudNavLink Href="/sucursal" Icon="@Icons.Material.Filled.Store">
                Sucursales
            </MudNavLink>
            
            <AuthorizeView Roles="Administrador">
                <MudNavLink Href="/turnotrabajo" Icon="@Icons.Material.Filled.AccessTime">
                    Turnos de Trabajo
                </MudNavLink>
            </AuthorizeView>
        </MudNavGroup>
    </AuthorizeView>

    <!-- Configuración - Solo Administrador -->
    <AuthorizeView Roles="Administrador">
        <MudDivider Class="my-2" />
        <MudNavGroup Text="Configuración" Icon="@Icons.Material.Filled.Settings" Expanded="false">
            <MudNavLink Href="/departamento" Icon="@Icons.Material.Filled.Map">
                Departamentos
            </MudNavLink>
            <MudNavLink Href="/municipio" Icon="@Icons.Material.Filled.LocationCity">
                Municipios
            </MudNavLink>
            <MudNavLink Href="/genero" Icon="@Icons.Material.Filled.Wc">
                Géneros
            </MudNavLink>
            <MudNavLink Href="/estadocivil" Icon="@Icons.Material.Filled.Favorite">
                Estado Civil
            </MudNavLink>
            <MudNavLink Href="/roles" Icon="@Icons.Material.Filled.Security">
                Roles
            </MudNavLink>
        </MudNavGroup>
    </AuthorizeView>

    <!-- Acceso rápido según el rol -->
    <MudDivider Class="my-2" />
    
    <AuthorizeView Roles="Vendedor">
        <MudText Typo="Typo.caption" Class="px-4 py-2" Style="color: rgba(255,255,255,0.7);">
            Acceso Rápido
        </MudText>
        <MudNavLink Href="/ventas" Icon="@Icons.Material.Filled.ShoppingCart">
            Nueva Venta
        </MudNavLink>
        <MudNavLink Href="/producto" Icon="@Icons.Material.Filled.Search">
            Buscar Producto
        </MudNavLink>
    </AuthorizeView>

    <AuthorizeView Roles="Farmaceuta">
        <MudText Typo="Typo.caption" Class="px-4 py-2" Style="color: rgba(255,255,255,0.7);">
            Acceso Rápido
        </MudText>
        <MudNavLink Href="/inventario" Icon="@Icons.Material.Filled.Inventory2">
            Control Stock
        </MudNavLink>
        <MudNavLink Href="/producto/agregar" Icon="@Icons.Material.Filled.Add">
            Nuevo Producto
        </MudNavLink>
    </AuthorizeView>
</MudNavMenu>

<style>
    .mud-nav-link {
        color: rgba(255, 255, 255, 0.8) !important;
        transition: all 0.3s ease;
        border-radius: 4px;
        margin: 2px 8px;
    }

    .mud-nav-link:hover {
        color: white !important;
        background-color: rgba(255, 255, 255, 0.1) !important;
    }

    .mud-nav-link.active {
        color: white !important;
        background-color: rgba(255, 255, 255, 0.2) !important;
    }

    .mud-nav-group-header {
        color: rgba(255, 255, 255, 0.9) !important;
    }

    .mud-nav-group-header:hover {
        color: white !important;
        background-color: rgba(255, 255, 255, 0.1) !important;
    }

    .mud-divider {
        border-color: rgba(255, 255, 255, 0.2) !important;
    }
</style>