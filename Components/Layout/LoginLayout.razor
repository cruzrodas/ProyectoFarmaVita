@inherits LayoutComponentBase
@using MudBlazor

<MudThemeProvider Theme="customTheme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="login-page-container">
    @Body
</div>

<style>
    /* Reset completo para evitar interferencias de Bootstrap */
    .login-page-container * {
        box-sizing: border-box;
    }

    .login-page-container {
        min-height: 100vh;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
        font-family: 'Roboto', sans-serif !important;
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        z-index: 9999;
    }

        /* Override específicos de Bootstrap que pueden interferir */
        .login-page-container .mud-paper {
            background: rgba(255, 255, 255, 0.95) !important;
            backdrop-filter: blur(10px) !important;
            border-radius: 20px !important;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15) !important;
            border: none !important;
            max-width: 420px !important;
            width: 100% !important;
            margin: 0 auto !important;
            padding: 0 !important;
        }

        /* Contenido interno de la tarjeta */
        .login-page-container .login-card-content {
            padding: 3rem !important;
        }

        /* Header section */
        .login-page-container .login-header {
            text-align: center !important;
            margin-bottom: 2.5rem !important;
        }

        .login-page-container .login-icon {
            color: #667eea !important;
            font-size: 4rem !important;
            margin-bottom: 1rem !important;
            display: block !important;
        }

        .login-page-container .login-title {
            font-weight: 700 !important;
            color: #667eea !important;
            font-size: 2.5rem !important;
            margin-bottom: 0.5rem !important;
            line-height: 1.2 !important;
            font-family: 'Roboto', sans-serif !important;
        }

        .login-page-container .login-subtitle {
            color: #666 !important;
            opacity: 0.8 !important;
            font-size: 1rem !important;
            margin-bottom: 0 !important;
            font-family: 'Roboto', sans-serif !important;
        }

        /* Form header */
        .login-page-container .login-form-title {
            text-align: center !important;
            margin-bottom: 2rem !important;
            color: #667eea !important;
            font-weight: 600 !important;
            font-family: 'Roboto', sans-serif !important;
        }

        /* Input fields - Override Bootstrap form controls */
        .login-page-container .mud-input-control {
            background-color: rgba(255, 255, 255, 0.9) !important;
            border-radius: 12px !important;
            border: 2px solid rgba(102, 126, 234, 0.1) !important;
            transition: all 0.3s ease !important;
            margin-bottom: 1.5rem !important;
            font-family: 'Roboto', sans-serif !important;
        }

            .login-page-container .mud-input-control:hover {
                background-color: rgba(255, 255, 255, 1) !important;
                border-color: rgba(102, 126, 234, 0.3) !important;
            }

            .login-page-container .mud-input-control:focus-within {
                border-color: #667eea !important;
                box-shadow: 0 0 0 2px rgba(102, 126, 234, 0.2) !important;
            }

        /* Override Bootstrap form-control class */
        .login-page-container .form-control {
            display: block !important;
            width: 100% !important;
            padding: 0.375rem 0.75rem !important;
            font-size: 1rem !important;
            font-weight: 400 !important;
            line-height: 1.5 !important;
            color: #212529 !important;
            background-color: transparent !important;
            background-clip: padding-box !important;
            border: none !important;
            border-radius: 0 !important;
            transition: none !important;
        }

        /* Checkbox */
        .login-page-container .login-checkbox {
            margin: 1.5rem 0 !important;
            font-family: 'Roboto', sans-serif !important;
        }

        /* Button - Override Bootstrap btn classes */
        .login-page-container .login-button {
            background: linear-gradient(45deg, #667eea 0%, #764ba2 100%) !important;
            color: white !important;
            border-radius: 12px !important;
            height: 52px !important;
            font-weight: 600 !important;
            font-size: 1.1rem !important;
            text-transform: none !important;
            box-shadow: 0 4px 15px rgba(102, 126, 234, 0.4) !important;
            transition: all 0.3s ease !important;
            margin-top: 1.5rem !important;
            border: none !important;
            width: 100% !important;
            font-family: 'Roboto', sans-serif !important;
            display: flex !important;
            align-items: center !important;
            justify-content: center !important;
        }

            .login-page-container .login-button:hover {
                box-shadow: 0 8px 25px rgba(102, 126, 234, 0.6) !important;
                transform: translateY(-2px) !important;
                background: linear-gradient(45deg, #5a6fd8 0%, #6a4190 100%) !important;
            }

            .login-page-container .login-button:disabled {
                background: #cccccc !important;
                box-shadow: none !important;
                transform: none !important;
                cursor: not-allowed !important;
            }

        /* Validation errors */
        .login-page-container .validation-summary {
            background-color: #ffebee !important;
            border: 1px solid #f44336 !important;
            border-radius: 12px !important;
            padding: 1rem !important;
            margin: 1rem 0 !important;
            font-family: 'Roboto', sans-serif !important;
        }

            .login-page-container .validation-summary ul {
                margin: 0 !important;
                padding-left: 1.2rem !important;
                color: #d32f2f !important;
                list-style-type: disc !important;
            }

            .login-page-container .validation-summary li {
                margin: 0.3rem 0 !important;
            }

        /* Links and footer */
        .login-page-container .login-links {
            text-align: center !important;
            margin: 1.5rem 0 !important;
        }

        .login-page-container .login-footer {
            text-align: center !important;
            margin-top: 2rem !important;
            opacity: 0.7 !important;
            font-family: 'Roboto', sans-serif !important;
        }

        /* Divider */
        .login-page-container .mud-divider {
            margin: 2rem 0 1.5rem 0 !important;
        }

        /* Progress circular */
        .login-page-container .mud-progress-circular {
            margin-right: 12px !important;
            color: white !important;
        }

    /* Responsive */
    @@media (max-width: 480px) {
        .login-page-container

    {
        padding: 15px !important;
    }

    .login-page-container .login-card-content {
        padding: 2rem !important;
    }

    .login-page-container .login-title {
        font-size: 2rem !important;
    }

    .login-page-container .mud-paper {
        border-radius: 16px !important;
    }

    }
</style>

@code {
    private MudTheme customTheme = new()
    {
        PaletteLight = new PaletteLight()
        {
            Primary = "#667eea",
            Secondary = "#764ba2",
            AppbarBackground = "#667eea",
            Background = "#f5f5f5",
            Surface = "#ffffff",
            TextPrimary = "#212121",
            TextSecondary = "#666666"
        },
        LayoutProperties = new LayoutProperties()
        {
            DrawerWidthLeft = "260px",
            DrawerWidthRight = "300px"
        }
    };
}