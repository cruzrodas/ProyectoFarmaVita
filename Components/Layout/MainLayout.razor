@inherits LayoutComponentBase
@using ProyectoFarmaVita.Services.AuthServices
@using Microsoft.AspNetCore.Authorization
@inject IAuthService AuthService
@inject NavigationManager NavigationManager
@attribute [Authorize]

<MudThemeProvider Theme="customTheme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

@if (isLoading)
{
    <div class="d-flex justify-content-center align-items-center" style="height: 100vh;">
        <div class="text-center">
            <MudProgressCircular Size="Size.Large" Indeterminate="true" />
            <MudText Typo="Typo.body1" Class="mt-3">Cargando...</MudText>
        </div>
    </div>
}
else if (currentUser != null)
{
    <MudLayout>
        <MudAppBar Elevation="1" Dense="true">
            <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@ToggleDrawer" />
            <MudSpacer />
            <MudText Typo="Typo.h6" Class="ml-3">FarmaVita</MudText>
            <MudSpacer />

            <MudMenu Icon="@Icons.Material.Filled.AccountCircle" Color="Color.Inherit" Dense="true">
                <MudMenuItem>
                    <div class="d-flex flex-column">
                        <MudText Typo="Typo.body2">@currentUser.Nombre @currentUser.Apellido</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@(currentUser.IdRoolNavigation?.TipoRol ?? "Sin rol")</MudText>
                    </div>
                </MudMenuItem>
                <MudDivider />
                <MudMenuItem Icon="@Icons.Material.Filled.Person" OnClick="@(() => NavigationManager.NavigateTo($"/personas/editar/{currentUser.IdPersona}"))">
                    Mi Perfil
                </MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Filled.Settings">
                    Configuración
                </MudMenuItem>
                <MudDivider />
                <MudMenuItem Icon="@Icons.Material.Filled.Logout" OnClick="@HandleLogout">
                    Cerrar Sesión
                </MudMenuItem>
            </MudMenu>
        </MudAppBar>

        <MudDrawer @bind-Open="@_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="2">
            <NavMenu />
        </MudDrawer>

        <MudMainContent>
            <MudContainer MaxWidth="MaxWidth.False" Class="pa-4">
                @Body
            </MudContainer>
        </MudMainContent>
    </MudLayout>
}
else
{
    <div class="d-flex justify-content-center align-items-center" style="height: 100vh;">
        <div class="text-center">
            <MudText Typo="Typo.h5" Color="Color.Error">Error de autenticación</MudText>
            <MudText Typo="Typo.body1" Class="mt-2">Redirigiendo al login...</MudText>
            <MudProgressLinear Indeterminate="true" Class="mt-3" />
        </div>
    </div>
}

<div id="blazor-error-ui" data-nosnippet>
    Ha ocurrido un error inesperado.
    <a href="." class="reload">Recargar</a>
    <span class="dismiss">🗙</span>
</div>

<style>
    .mud-appbar {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%) !important;
    }

    .mud-drawer {
        background: linear-gradient(180deg, #667eea 0%, #764ba2 100%) !important;
    }

        .mud-drawer .mud-nav-link {
            color: rgba(255, 255, 255, 0.8) !important;
            transition: all 0.3s ease;
        }

            .mud-drawer .mud-nav-link:hover {
                color: white !important;
                background-color: rgba(255, 255, 255, 0.1) !important;
            }

            .mud-drawer .mud-nav-link.active {
                color: white !important;
                background-color: rgba(255, 255, 255, 0.2) !important;
            }

    #blazor-error-ui {
        background: lightyellow;
        bottom: 0;
        box-shadow: 0 -1px 2px rgba(0, 0, 0, 0.2);
        display: none;
        left: 0;
        padding: 0.6rem 1.25rem 0.7rem 1.25rem;
        position: fixed;
        width: 100%;
        z-index: 1000;
    }

        #blazor-error-ui .dismiss {
            cursor: pointer;
            position: absolute;
            right: 0.75rem;
            top: 0.5rem;
        }
</style>

@code {
    private bool _drawerOpen = true;
    private Models.Persona? currentUser;
    private bool isLoading = true;

    private MudTheme customTheme = new()
    {
        PaletteLight = new PaletteLight()
        {
            Primary = "#667eea",
            Secondary = "#764ba2",
            AppbarBackground = "#667eea",
            Background = "#f5f5f5",
            Surface = "#ffffff",
            TextPrimary = "#212121",
            TextSecondary = "#666666"
        },
        LayoutProperties = new LayoutProperties()
        {
            DrawerWidthLeft = "260px",
            DrawerWidthRight = "300px"
        }
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Console.WriteLine("🔧 MainLayout: OnInitializedAsync iniciado");

            // Pequeño delay para asegurar que el contexto esté listo
            await Task.Delay(100);

            // Verificar autenticación
            if (!AuthService.IsAuthenticated)
            {
                Console.WriteLine("❌ MainLayout: Usuario no autenticado, redirigiendo a login");
                NavigationManager.NavigateTo("/login", forceLoad: true);
                return;
            }

            Console.WriteLine("✅ MainLayout: Usuario autenticado, cargando datos");

            // Obtener usuario actual
            currentUser = await AuthService.GetCurrentUserAsync();

            if (currentUser == null)
            {
                Console.WriteLine("❌ MainLayout: No se pudo cargar usuario, redirigiendo a login");
                NavigationManager.NavigateTo("/login", forceLoad: true);
                return;
            }

            Console.WriteLine($"✅ MainLayout: Usuario cargado - {currentUser.Nombre} {currentUser.Apellido}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"💥 MainLayout ERROR: {ex.Message}");
            NavigationManager.NavigateTo("/login", forceLoad: true);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
            Console.WriteLine("🔧 MainLayout: Carga completada");
        }
    }

    private void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
        Console.WriteLine($"🔧 MainLayout: Drawer toggled - Open: {_drawerOpen}");
    }

    private async Task HandleLogout()
    {
        try
        {
            Console.WriteLine("🔧 MainLayout: Iniciando logout");

            isLoading = true;
            StateHasChanged();

            await AuthService.LogoutAsync();

            Console.WriteLine("✅ MainLayout: Logout completado, redirigiendo");

            // Forzar recarga completa para limpiar el estado
            NavigationManager.NavigateTo("/login", forceLoad: true);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"💥 MainLayout ERROR en logout: {ex.Message}");
            // En caso de error, forzar navegación al login
            NavigationManager.NavigateTo("/login", forceLoad: true);
        }
    }
}