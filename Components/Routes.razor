@using Microsoft.AspNetCore.Components.Authorization

<Router AppAssembly="typeof(Program).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)">
            <NotAuthorized Context="authContext">
                @if (authContext.User.Identity?.IsAuthenticated != true)
                {
                    <!-- Usuario no autenticado - redirigir al login -->
                    <LayoutView Layout="typeof(Layout.LoginLayout)">
                        <div class="d-flex justify-content-center align-items-center" style="height: 100vh;">
                            <div class="text-center">
                                <h3>Acceso no autorizado</h3>
                                <p>Redirigiendo al login...</p>
                                <script>window.location.href = '/login';</script>
                            </div>
                        </div>
                    </LayoutView>
                }
                else
                {
                    <!-- Usuario autenticado pero sin permisos -->
                    <LayoutView Layout="typeof(Layout.MainLayout)">
                        <div class="container mt-5 text-center">
                            <div class="card">
                                <div class="card-body">
                                    <h1 class="text-danger">403</h1>
                                    <h2>Acceso Denegado</h2>
                                    <p class="lead mt-3">No tienes permisos para acceder a esta página.</p>
                                    <a href="/" class="btn btn-primary mt-3">Ir al Dashboard</a>
                                </div>
                            </div>
                        </div>
                    </LayoutView>
                }
            </NotAuthorized>
            <Authorizing>
                <div class="d-flex justify-content-center align-items-center" style="height: 100vh;">
                    <div class="text-center">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Cargando...</span>
                        </div>
                        <p class="mt-3">Verificando autenticación...</p>
                    </div>
                </div>
            </Authorizing>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
    <NotFound>
        <PageTitle>Página no encontrada</PageTitle>
        <AuthorizeView>
            <Authorized>
                <LayoutView Layout="typeof(Layout.MainLayout)">
                    <div class="container mt-5 text-center">
                        <div class="card">
                            <div class="card-body">
                                <h1 class="text-warning display-1">404</h1>
                                <h2>Página no encontrada</h2>
                                <p class="lead mt-3">La página que buscas no existe.</p>
                                <a href="/" class="btn btn-primary mt-3">Ir al Dashboard</a>
                            </div>
                        </div>
                    </div>
                </LayoutView>
            </Authorized>
            <NotAuthorized>
                <LayoutView Layout="typeof(Layout.LoginLayout)">
                    <script>window.location.href = '/login';</script>
                </LayoutView>
            </NotAuthorized>
        </AuthorizeView>
    </NotFound>
</Router>